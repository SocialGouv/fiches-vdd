        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "element",
                  "name": "LienIntra",
                  "attributes": {
                    "LienID": "R12443",
                    "type": "Définition de glossaire"
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "L'hypothèque"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " a la même durée que le crédit immobilier."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Cependant, l’hypothèque reste inscrite au "
                },
                {
                  "type": "element",
                  "name": "LienIntra",
                  "attributes": {
                    "LienID": "R63009",
                    "type": "Définition de glossaire"
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "service de la publicité foncière "
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "durant 1 année après la fin du remboursement du crédit."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Durant cette année suplémentaire, elle est sans effet, car le crédit est remboursé."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "À la fin de cette année supplémentaire, l'inscription de l’hypothèque disparaît automatiquement, sans que vous ayez à payer de frais, ni à faire de démarche."
                }
              ]
            },
            {
              "type": "element",
              "name": "ASavoir",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "text",
                      "text": "À savoir"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous avez besoin d’obtenir la levée de l’hypothèque (c’est-à-dire de faire annuler l’hypothèque) "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "avant ce délai"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", vous devez "
                    },
                    {
                      "type": "element",
                      "name": "LienInterne",
                      "attributes": {
                        "LienPublication": "F787",
                        "type": "Fiche Question-réponse conditionnée",
                        "audience": "Particuliers"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "la réclamer"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Vous aurez alors des frais de "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R77373",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "mainlevée"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " à payer. Le montant de ces frais dépend de la valeur de votre crédit initial."
                    }
                  ]
                }
              ]
            }
          ]
