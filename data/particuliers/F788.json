                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Décision qui met fin de manière anticipée à l’exécution d’une mesure"
                    }
                  ]
                }
              ]
            }
          ]
        },
