            }
          ]
        },
        {
          "type": "element",
          "name": "Introduction",
          "children": [
            {
              "type": "element",
              "name": "Texte",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous êtes "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R46210",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "européen"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", votre liberté de circuler et de séjourner en France (et celle de votre famille) peut être remise en cause dans des cas limités. Vous pouvez faire l'objet d'une interdiction administrative du territoire (IAT), d'une obligation de quitter la France (OQTF) ou d'une décision d'expulsion. Nous faisons un point sur la règlementation."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Un étranger européen peut-il faire l’objet d’une interdiction administrative du territoire (IAT) ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous pouvez vous voir refuser l'entrée en France si votre comportement (ou celui d'un membre de votre famille) constitue une menace pour"
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R50177",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": " l'ordre et la sécurité publics"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Cette menace doit être réelle, actuelle et suffisamment grave pour un intérêt fondamental de la société."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous faites alors l'objet d'une "
                    },
                    {
                      "type": "element",
                      "name": "LienInterne",
                      "attributes": {
                        "LienPublication": "F32514",
                        "type": "Fiche Question-réponse conditionnée",
                        "audience": "Particuliers"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "interdiction administrative du territoire (IAT)"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Cette interdiction peut être contestée."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous pouvez faire un "
                    },
                    {
                      "type": "element",
                      "name": "LienInterne",
                      "attributes": {
                        "LienPublication": "F2474",
                        "type": "Fiche d'information conditionnée",
                        "audience": "Particuliers"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "recours administratif"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " devant le ministre de l’intérieur."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "OuSAdresser",
                  "attributes": {
                    "ID": "R10024",
                    "sve": "non",
                    "type": "National"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "Ministère en charge de l'intérieur"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "RessourceWeb",
                      "attributes": {
                        "URL": "https://lannuaire.service-public.fr/gouvernement/fa33b07a-3f71-46d4-b682-569c9faf211e"
                      }
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous pouvez également "
                    },
                    {
                      "type": "element",
                      "name": "LienInterne",
                      "attributes": {
                        "LienPublication": "F2026",
                        "type": "Fiche d'information conditionnée",
                        "audience": "Particuliers"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "déposer un recours"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " devant le tribunal administratif de Paris et le "
                    },
                    {
                      "type": "element",
                      "name": "LienInterne",
                      "attributes": {
                        "LienPublication": "F2551",
                        "type": "Fiche d'information conditionnée",
                        "audience": "Particuliers"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "saisir en référé"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "OuSAdresser",
                  "attributes": {
                    "ID": "R38689",
                    "sve": "non",
                    "type": "National"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "Tribunal administratif de Paris"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "RessourceWeb",
                      "attributes": {
                        "URL": "https://paris.tribunal-administratif.fr/vos-demarches/contacts-et-informations-pratiques"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Un étranger européen peut-il faire l’objet d’une obligation de quitter la France (OQTF) ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Les dispositions générales sur l’éloignement, comme l’OQTF, ne s’appliquent pas de la même manière aux citoyens européens en raison du principe de libre circulation."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous (ou un membre de votre famille) pouvez faire l'objet d'une obligation de quitter le territoire français (OQTF) dans l’un des cas suivants :"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Liste",
                  "attributes": {
                    "type": "puce"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Absence de droit au séjour en France"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " : si vous n'avez pas (ou plus) de droit au séjour"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Abus de droit au séjour"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " : par exemple, si vous vivez en France dans le but essentiel de percevoir des aides et des prestations sociales. C'est le cas aussi si vous multipliez les séjours de moins de 3 mois alors que vous ne remplissez pas les conditions pour séjourner plus de 3 mois (absence de travail ou de ressources)."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Menace grave à l'"
                                },
                                {
                                  "type": "element",
                                  "name": "LienIntra",
                                  "attributes": {
                                    "LienID": "R50177",
                                    "type": "Définition de glossaire"
                                  },
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "ordre public"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "text": " durant les 3 premiers mois de séjour en France"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " : votre comportement représente une menace réelle, actuelle et suffisamment grave pour un intérêt fondamental de la société française."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous avez fait l’objet d’une OQTF, vous avez un délai d’1 mois à compter de la "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R14732",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "notification"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " de la décision pour quitter volontairement la France."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "L’autorité administrative peut assortir l’OQTF d’une interdiction de circulation sur le territoire français (ICTF) d’une durée maximale de 3 ans."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Toutefois, si vous bénéficiez d’un droit au séjour permanent en France (plus de 5 ans de séjour régulier et ininterrompu), vous ne pouvez pas faire l’objet d’une OQTF, ni votre famille."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Un étranger européen peut-il faire l’objet d’une expulsion du territoire français ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "La situation diffère selon que vous vivez ou non en France depuis 10 ans avec un titre de séjour :"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "BlocCas",
                  "attributes": {
                    "affichage": "radio"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Cas",
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "\nVous vivez en France depuis 10 ans avec un titre de séjour"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Vous ne pouvez pas être expulsé si vous vivez en France depuis 10 ans avec un titre de séjour."
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Toutefois, l'expulsion est possible si vous portez atteinte à la sûreté de l'État ou à la sécurité publique."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Cas",
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "\nAutre cas"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Vous pouvez "
                            },
                            {
                              "type": "element",
                              "name": "LienInterne",
                              "attributes": {
                                "LienPublication": "F11891",
                                "type": "Fiche d'information conditionnée",
                                "audience": "Particuliers"
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "text": "être expulsé"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " si votre comportement représente une menace réelle, actuelle et suffisamment grave pour un intérêt fondamental de la société française."
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "La même mesure peut être prononcée à l'encontre d'un membre de votre famille s'il représente aussi une telle menace."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
