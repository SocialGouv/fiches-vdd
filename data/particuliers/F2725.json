        },
        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "L'assurance d'un bateau de plaisance, en France, est "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "facultative"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", sauf exception ;"
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Certains ports ou marinas peuvent également exiger une attestation d'assurance pour vous permettre d’obtenir une place d'amarrage."
                }
              ]
            },
            {
              "type": "element",
              "name": "TitreFlottant",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Dans quel cas l’assurance d’un bateau de plaisance est obigatoire ?"
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Une assurance ou une autre garantie financière est obligatoire lorsque les 2 conditions suivantes sont réunies :"
                }
              ]
            },
            {
              "type": "element",
              "name": "Liste",
              "attributes": {
                "type": "puce"
              },
              "children": [
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "le bateau "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "est enregistré sous pavillon français"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " ou "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "entre dans un port français"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ","
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "et sa jauge brute est "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "égale ou supérieure à 300"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Cette obligation concerne le "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "propriétaire du bateau"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " ou la personne qui est responsable de son exploitation, par exemple une personne qui loue le bateau sans équipage pour l'exploiter elle-même."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "element",
                  "name": "MiseEnEvidence"
                },
                {
                  "type": "text",
                  "text": "L'assurance ou la garantie financière permet de prendre en charge certaines sommes qui peuvent être dues en cas de dommages liés à l'exploitation du bateau."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "element",
                  "name": "MiseEnEvidence"
                },
                {
                  "type": "text",
                  "text": "Un certificat attestant que l'assurance ou la garantie financière est en cours de validité doit être conservé à bord du bateau."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "element",
                  "name": "MiseEnEvidence"
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence"
                },
                {
                  "type": "text",
                  "text": "Une garantie financière est une garantie qui permet de payer les sommes dues lorsqu'un dommage couvert par la réglementation survient. Elle peut, dans les cas prévus par la loi, remplacer l'assurance."
                }
              ]
            },
            {
              "type": "element",
              "name": "TitreFlottant",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Pourquoi souscrire une assurance si elle n’est pas obigatoire ?"
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Même lorsqu'elle n'est pas obligatoire, une assurance peut vous protéger contre les conséquences financières d'un accident."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Elle peut notamment couvrir les dommages corporels ou matériels causés à des tiers lorsque votre responsabilité est engagée."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Elle peut également couvrir les dommages subis par votre bateau, selon les garanties prévues par le contrat."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "En l’absence d’assurance, vous devrez indemniser personnellement les victimes, ce qui peut avoir de lourdes conséquences financières en cas d’accident."
                }
              ]
            },
            {
              "type": "element",
              "name": "TitreFlottant",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Quelle assurance est-il possible de souscrire pour un bateau de plaisance ?"
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Vous pouvez souscrire une assurance "
                },
                {
                  "type": "element",
                  "name": "LienIntra",
                  "attributes": {
                    "LienID": "R47105",
                    "type": "Définition de glossaire"
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "responsabilité civile"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " pour couvrir les dommages corporels ou matériels causés à des tiers lorsque votre responsabilité est engagée."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Vous pouvez également souscrire un contrat d'assurance plus complet, généralement appelé assurance « multirisques plaisance »."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Ce type de contrat peut notamment couvrir :"
                }
              ]
            },
            {
              "type": "element",
              "name": "Liste",
              "attributes": {
                "type": "puce"
              },
              "children": [
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "les dommages causés au bateau, par exemple en cas d'incendie, de tempête, de naufrage, d'échouement ou de collision,"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "le vol du bateau et, selon le contrat, de certains équipements,"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "les frais de retirement ou de destruction de l'épave,"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "les frais de remorquage,"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "l'assistance au bateau ou aux personnes."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Les garanties et leurs conditions de prise en charge varient selon les contrats. Il est notamment important de vérifier les exclusions, les montants garantis et les éventuelles franchises."
                }
              ]
            },
            {
              "type": "element",
              "name": "ASavoir",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "text",
                      "text": "À savoir"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "la responsabilité civile peut, dans certains cas, être incluse dans un contrat d'"
                    },
                    {
                      "type": "element",
                      "name": "LienInterne",
                      "attributes": {
                        "LienPublication": "F2123",
                        "type": "Fiche Question-réponse conditionnée",
                        "audience": "Particuliers"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "assurance habitation"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". La couverture peut toutefois être limitée, notamment en fonction des caractéristiques du bateau. Il est vivement conseillé de vérifier les garanties prévues par votre contrat."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "TitreFlottant",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Où souscrire une assurance pour un bateau de plaisance ?"
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Vous pouvez souscrire une assurance auprès de n’importe quelle compagnie proposant des contrats adaptés à la navigation de plaisance."
                }
              ]
            },
            {
              "type": "element",
              "name": "Attention",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "text",
                      "text": "Attention"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "avant de souscrire, il est important de vérifier que les garanties proposées correspondent notamment aux caractéristiques de votre bateau, à son utilisation et à votre zone de navigation."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Vous devrez présenter les documents du bateau (titre de propriété, certificat d’immatriculation) et le permis de navigation du conducteur pour constituer votre dossier."
                }
              ]
            },
            {
              "type": "element",
              "name": "TitreFlottant",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Un port peut-il exiger une assurance ?"
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Même lorsque la loi ne vous impose pas d'assurer votre bateau, le gestionnaire d'un port ou d'une marina peut exiger une attestation d'assurance pour vous attribuer une place d'amarrage."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Il est donc recommandé de vérifier les conditions d'accès au port avant de demander une place."
                }
              ]
            }
          ]
        },
