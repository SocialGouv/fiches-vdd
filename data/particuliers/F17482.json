        },
        {
          "type": "element",
          "name": "Introduction",
          "children": [
            {
              "type": "element",
              "name": "Texte",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Les bourses Talents permettent de soutenir financièrement les candidats les plus méritants à préparer certains concours de la fonction publique. Depuis la rentrée 2021-2022, le dispositif des bourses Talents "
                    },
                    {
                      "type": "element",
                      "name": "Expression"
                    },
                    {
                      "type": "text",
                      "text": "a remplacé l'allocation pour la diversité dans la fonction publique."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Qui peut bénéficier de la bourse Talents ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous êtes inscrit dans un "
                    },
                    {
                      "type": "element",
                      "name": "LienExterne",
                      "attributes": {
                        "URL": "https://www.fonction-publique.gouv.fr/score/talents-du-service-public"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "cursus de formation Prépa Talents ou Parcours Talents"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", vous avez droit à la bourse."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Les Prépas Talents et Parcours Talents sont destinées aux étudiants et aux demandeurs d'emploi, sélectionnés sous conditions de ressources, de mérite et de motivation. Elles les préparent à certains concours de la fonction publique. Chaque élève bénéficie notamment d'un tutorat renforcé."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Ces cursus de formation sont intégrés à des écoles de service public, à des universités, à des instituts d'études politiques, ou à des centres ou instituts de préparation à l'administration générale (CPAG ou IPAG)."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Comment demander la bourse Talents ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Il n'y a pas de démarche à réaliser."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Votre établissement transmet la liste des élèves inscrit en Prépa Talents ou en Parcours Talents au préfet de région, au plus tard "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "dans le mois suivant le début de la scolarité"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Comment la bourse Talents est-elle attribuée ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "La bourse vous est attribuée automatiquement par le préfet."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Pendant combien de temps la bourse Talents est-elle attribuée ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "La bourse est accordée pour une durée maximale d'"
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "1 an"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Exceptionnellement, elle peut être renouvelée une fois, sous conditions, si vous effectuez une seconde année de formation en Prépa Talents ou en Parcours Talents."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Quel est le montant de la bourse Talents ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Le montant de la bourse est de "
                    },
                    {
                      "type": "element",
                      "name": "Valeur",
                      "children": [
                        {
                          "type": "text",
                          "text": "5 000 €"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Quelles sont les conditions de versement de la bourse Talents ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "La bourse Talents est versée "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "en 2 fois"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "element",
                      "name": "Valeur",
                      "children": [
                        {
                          "type": "text",
                          "text": "2 500 €"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " entre la rentrée scolaire et la fin du mois de novembre et "
                    },
                    {
                      "type": "element",
                      "name": "Valeur",
                      "children": [
                        {
                          "type": "text",
                          "text": "2 500 €"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " à partir du mois de mars."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Pour obtenir le second versement de "
                    },
                    {
                      "type": "element",
                      "name": "Valeur",
                      "children": [
                        {
                          "type": "text",
                          "text": "2 500 €"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", les documents suivants doivent être transmis au préfet de région :"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Liste",
                  "attributes": {
                    "type": "puce"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Attestation d'assiduité"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " aux enseignements et de présentation aux examens suivis au sein de la préparation. L’établissement dans lequel vous êtes inscrit transmet ce document au préfet de région."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Attestation de présence"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " ou "
                            },
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "relevé de notes"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " aux épreuves pour au moins un des concours préparés dans le cadre de la Prépa Talents ou du Parcours Talents. Dans le cas où les épreuves du concours visé ont lieu après à la date fixée par le préfet de région pour la transmission des justificatifs, vous devez transmettre une attestation d'inscription à ce concours. Si les inscriptions à ce concours ne sont pas encore ouvertes à cette date, vous devez transmettre une attestation sur l'honneur de vous y inscrire. Dans ces deux derniers cas, vous devez transmettre au préfet de région une attestation de présence au concours concerné dès que ce dernier a eu lieu."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si les documents demandés ne sont pas transmis, le second versement de la bourse Talents est suspendu."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Quelles sont les obligations de la personne qui bénéficie de la bourse Talents ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous devez suivre de manière assidue la préparation."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous devez également vous présenter, à la fin de votre préparation, aux épreuves d'admissibilité de l'un des concours pour lesquels l'aide de l'État vous a été accordée."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous ne respectez pas ces obligations, vous devez rembourser le montant de la bourse."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "ANoter",
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "À noter"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Si l’interruption de la formation est due à la réussite de certains concours ou à des motifs graves et sérieux, vous ne devrez pas rembourser le montant de la bourse."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
