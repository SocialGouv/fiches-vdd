        {
          "type": "element",
          "name": "Introduction",
          "children": [
            {
              "type": "element",
              "name": "Texte",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous pouvez contester une facture d'eau dont le montant est anormalement élevé, sous certaines conditions. Nous vous présentons les informations à connaître."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Qu'est-ce qu'une consommation d’eau « anormalement élevée » ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Une consommation d’eau est considérée comme "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "anormalement élevée"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " lorsqu’elle dépasse au moins "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "le double du volume moyen consommé au cours des 3 dernières années"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " précédant l'envoi de la facture."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous occupez votre logement depuis moins de 3 ans, votre service d'eau se base sur une consommation de référence. Cette consommation de référence prend en compte le volume moyen consommé dans votre zone géographique et pour des logements similaires au vôtre (taille, nombre de personnes vivant dans le logement...)."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "ASavoir",
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "À savoir"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "L’augmentation de votre facture d'eau peut venir d’une "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "fuite"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " sur votre installation d’eau (par exemple, canalisation). Il est donc recommandé de "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "vérifier vos installations et votre compteur d’eau"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Quelles sont les obligations du service d'eau en cas de consommation anormalement élevée ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Lorsqu'une augmentation anormale intervient, votre service de l’eau ou de l’assainissement a "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "l'obligation de vous en informer"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Vous êtes prévenu, en général, par courrier et au plus tard lors de l'envoi de votre facture d'eau."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous n'avez pas reçu d'information du fait d’un "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "manquement de votre service de l’eau ou de l’assainissement"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", vous n'avez pas à payer la part de consommation d'eau excédant le double de votre consommation moyenne. Les m"
                    },
                    {
                      "type": "element",
                      "name": "Exposant",
                      "children": [
                        {
                          "type": "text",
                          "text": "3"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " consommés au-delà de ce seuil ne vous sont donc pas facturés."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Comment contester une facture d'eau anormalement élevée ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Tout dépend si vous avez détecté ou non une fuite d'eau :"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "BlocCas",
                  "attributes": {
                    "affichage": "radio"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Cas",
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "\nFuite détectée"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Vous devez faire "
                            },
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "réparer la fuite"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " d’eau dans les plus "
                            },
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "brefs délais"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " par le professionnel de votre choix."
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Pour ne pas payer la part de consommation d'eau excédant le double de votre consommation moyenne, vous devez transmettre à votre service de l’eau ou de l’assainissement les documents suivants :"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Liste",
                          "attributes": {
                            "type": "puce"
                          },
                          "children": [
                            {
                              "type": "element",
                              "name": "Item",
                              "children": [
                                {
                                  "type": "element",
                                  "name": "Paragraphe",
                                  "children": [
                                    {
                                      "type": "element",
                                      "name": "MiseEnEvidence",
                                      "children": [
                                        {
                                          "type": "text",
                                          "text": "Attestation du professionnel"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": " ayant réparé la fuite, mentionnant la date de réparation et la localisation de la fuite"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "element",
                              "name": "Item",
                              "children": [
                                {
                                  "type": "element",
                                  "name": "Paragraphe",
                                  "children": [
                                    {
                                      "type": "element",
                                      "name": "MiseEnEvidence",
                                      "children": [
                                        {
                                          "type": "text",
                                          "text": "Notification du service de l’eau ou de l’assainissement"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": " vous informant de l’augmentation de votre consommation"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Ces documents doivent être adressés à votre service d’eau par courrier recommandé avec avis de réception dans un délai de 1 mois à partir de la notification vous informant de l’augmentation de votre consommation."
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Vous pouvez vous aider d'un modèle de lettre pour rédiger votre courrier :"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "ServiceEnLigne",
                          "attributes": {
                            "ID": "R33731",
                            "URL": "https://www.inc-conso.fr/content/suite-une-fuite-deau-apres-compteur-vous-demandez-le-plafonnement-de-votre-facture",
                            "audience": "Particuliers",
                            "type": "Modèle de document"
                          },
                          "children": [
                            {
                              "type": "element",
                              "name": "Titre",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Demander le plafonnement de sa facture d'eau suite à une fuite d'eau"
                                }
                              ]
                            },
                            {
                              "type": "element",
                              "name": "Source",
                              "attributes": {
                                "ID": "R30643"
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Institut national de la consommation (INC)"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Cas",
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "\nAucune fuite d’eau détectée"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Introduction",
                          "children": [
                            {
                              "type": "element",
                              "name": "Paragraphe",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Vous pouvez demander à votre service de l’eau ou de l’assainissement de "
                                },
                                {
                                  "type": "element",
                                  "name": "MiseEnEvidence",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "vérifier le fonctionnement de votre compteur d'eau"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "text": "."
                                }
                              ]
                            },
                            {
                              "type": "element",
                              "name": "Paragraphe",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Votre demande doit être adressée à votre service de l’eau ou de l’assainissement par courrier recommandé avec avis de réception dans un délai de 1 mois à partir de la "
                                },
                                {
                                  "type": "element",
                                  "name": "LienIntra",
                                  "attributes": {
                                    "LienID": "R14732",
                                    "type": "Définition de glossaire"
                                  },
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "notification"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "text": " vous informant de l'augmentation de votre consommation."
                                }
                              ]
                            },
                            {
                              "type": "element",
                              "name": "Paragraphe",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Votre service de l’eau ou de l’assainissement vérifie votre compteur pour déterminer la cause de cette augmentation. Il doit vous communiquer sa réponse dans un délai de 1 mois suivant cette vérification."
                                }
                              ]
                            },
                            {
                              "type": "element",
                              "name": "Paragraphe",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Les conséquences diffèrent selon que la vérification révèle ou non un dysfonctionnement de votre compteur :"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "BlocCas",
                          "attributes": {
                            "affichage": "radio"
                          },
                          "children": [
                            {
                              "type": "element",
                              "name": "Cas",
                              "children": [
                                {
                                  "type": "element",
                                  "name": "Titre",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "\nExistence d’un dysfonctionnement"
                                    }
                                  ]
                                },
                                {
                                  "type": "element",
                                  "name": "Paragraphe",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "Vous "
                                    },
                                    {
                                      "type": "element",
                                      "name": "MiseEnEvidence",
                                      "children": [
                                        {
                                          "type": "text",
                                          "text": "n'avez pas à payer"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": " la part de consommation excédant le double de votre consommation moyenne. Les m"
                                    },
                                    {
                                      "type": "element",
                                      "name": "Exposant",
                                      "children": [
                                        {
                                          "type": "text",
                                          "text": "3"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "text": " consommés au-delà de ce seuil ne vous sont donc pas facturés."
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "element",
                              "name": "Cas",
                              "children": [
                                {
                                  "type": "element",
                                  "name": "Titre",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "\nAbsence de dysfonctionnement"
                                    }
                                  ]
                                },
                                {
                                  "type": "element",
                                  "name": "Paragraphe",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "Vous "
                                    },
                                    {
                                      "type": "element",
                                      "name": "MiseEnEvidence",
                                      "children": [
                                        {
                                          "type": "text",
                                          "text": "devez payer"
                                        }
