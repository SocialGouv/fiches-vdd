        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Cléa s'adresse "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "principalement"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " à des salariés et demandeurs d'emploi "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "sans diplôme"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Il s'agit d'un "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "socle de connaissances et de compétences professionnelles"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " permettant de prouver la maîtrise des savoirs de base et renforcer ainsi votre présence sur le marché du travail."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Il est constitué de l’ensemble des connaissances et compétences utiles pour favoriser son insertion professionnelle."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Le socle de connaissances et de compétences couvre "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "7 domaines"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " :"
                }
              ]
            },
            {
              "type": "element",
              "name": "Liste",
              "attributes": {
                "type": "puce"
              },
              "children": [
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Savoir communiquer en français"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Savoir utiliser des règles de base de calcul et du raisonnement mathématique"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Savoir utiliser des techniques usuelles de l'information et de la communication numérique"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Être apte à travailler dans le cadre de règles définies d'un travail en équipe"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Travailler en autonomie et à réaliser un objectif individuel"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Avoir la capacité à apprendre tout au long de la vie"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Savoir maîtriser les gestes et postures de base, et respecter des règles d'hygiène, de sécurité et environnementale, élémentaires."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Ces formations peuvent être proposées indépendamment les unes des autres."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Des "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "modules complémentaires"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " peuvent s'ajouter."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Si vous prenez l'initiative pour obtenir CléA, un service en ligne vous permet de trouver un conseiller :"
                }
              ]
            },
            {
              "type": "element",
              "name": "ServiceEnLigne",
              "attributes": {
                "ID": "R65109",
                "URL": "https://www.certificat-clea.fr/contact/",
                "audience": "Particuliers",
                "type": "Outil de recherche"
              },
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "text",
                      "text": "Trouver un conseiller d'un organisme évaluateur (CléA)"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Source",
                  "attributes": {
                    "ID": "R30661"
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "Ministère chargé du travail"
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Il vous explique ce que CléA peut vous apporter. Il ouvre votre dossier CléA si vous le souhaitez et vous accompagne. Vos connaissances et compétences professionnelles seront évaluées."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Le "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "certificat CléA"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " peut s'obtenir :"
                }
              ]
            },
            {
              "type": "element",
              "name": "Liste",
              "attributes": {
                "type": "puce"
              },
              "children": [
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Directement si vous maîtrisez tous les domaines. En effet, si l’évaluation montre que vous maîtrisez toutes les bases nécessaires, votre dossier est immédiatement transmis à un jury"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Item",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Ou après une formation si certains éléments sont à acquérir. Une évaluation est faite par la suite sur ces éléments à acquérir."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Un jury composé de professionnels examine votre dossier. S’il est conforme aux exigences requises, vous obtenez votre certificat CléA."
                }
              ]
            },
            {
              "type": "element",
              "name": "ASavoir",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "text",
                      "text": "À savoir"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Le certificat CléA prend la forme d'un certificat numérique. Une version papier peut vous être donnée si vous la demandez."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "element",
          "name": "VoirAussi",
          "attributes": {
            "important": "non"
          },
          "children": [
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F10705",
                "audience": "Particuliers"
              },
              "children": [
