        {
          "type": "element",
          "name": "Introduction",
          "children": [
            {
              "type": "element",
              "name": "Texte",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous voulez réaliser un transfert d’argent immédiat à une de vos connaissances ? Grâce à Wero, sur l’application mobile de votre banque, vous n’avez plus besoin de saisir les coordonnées bancaires du bénéficiaire du paiement. Depuis votre smartphone, il suffit de saisir ou sélectionner un contact de votre répertoire (numéro de téléphone ou adresse mail) pour lui envoyer l’argent. De la même façon, vous pouvez aussi recevoir un paiement. Voici les informations à connaître pour utiliser Wero."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Qu’est-ce que Wero ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Wero permet de virer de l’argent de compte à compte en quelques secondes, gratuitement, depuis son application bancaire. C’est un "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "service de paiement instantané"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " développé à l’échelle européenne."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Wero est un système de "
                    },
                    {
                      "type": "element",
                      "name": "Expression",
                      "children": [
                        {
                          "type": "element",
                          "name": "LienExterne",
                          "attributes": {
                            "URL": "https://www.inc-conso.fr/content/le-portefeuille-electronique-ou-numerique"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "portefeuille électronique"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Ce système repose sur une base de données centralisée qui réalise la correspondance entre les numéros de téléphone mobile, les adresses mail et les "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R74040",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "IBAN"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " des utilisateurs de Wero. Pour utiliser cette base de données les banques doivent être adhérentes au service Wero. Les banques partenaires proposent ensuite Wero à leurs clients."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "L’émetteur (payeur) et le bénéficiaire du paiement instantané via Wero doivent être titulaires d’un compte de paiement domicilié dans une banque adhérente."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Pour utiliser Wero vous devez "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "activer"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " ce service dans l’"
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "application mobile de votre banque"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " sur votre smartphone."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "ASavoir",
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "À savoir"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Wero remplace Paylib qui ne fonctionne plus."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Qui peut utiliser Wero ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Wero est utilisable "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "entre particuliers"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " pour envoyer, demander et recevoir de l’argent."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Wero se développe progressivement auprès des commerçants pour permettre le paiement des achats en ligne ou en magasin."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "ANoter",
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "À noter"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Selon votre banque, et sous conditions, il est possible que Wero soit accessible à un mineur à partir de 16 ans, sous réserve de l’accord de l’un de ses "
                        },
                        {
                          "type": "element",
                          "name": "LienIntra",
                          "attributes": {
                            "LienID": "R72832",
                            "type": "Définition de glossaire"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "représentants légaux"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Comment activer Wero ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Pour activer Wero, vous devez passer par l’"
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "application mobile de votre banque"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " sur votre smartphone."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous devez sélectionner un "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R50674",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "compte courant"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " à votre nom que vous associez à Wero. Puis vous acceptez les conditions générales d’utilisation de Wero."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "C’est le compte que vous avez choisi et que vous avez associé à votre numéro de téléphone mobile qui pourra envoyer et recevoir de l’argent avec Wero."
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Comment envoyer de l’argent avec Wero ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Avec Wero, vous réalisez un virement d’argent de compte à compte en saisissant uniquement le numéro de téléphone mobile ou l’adresse mail du bénéficiaire. Vous n’avez plus besoin de connaitre son "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R74040",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "IBAN"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Si vous êtes en face à face au moment de l’opération, vous pouvez aussi utiliser un QR code à scanner."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Avec votre smartphone, sur l’application mobile de votre banque, quand Wero est activé pour vous et pour le bénéficiaire du paiement :"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Liste",
                  "attributes": {
                    "type": "puce"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Saisissez le montant à envoyer à votre contact. Saisissez ou sélectionnez le numéro de téléphone ou l’adresse mail de votre contact puis validez l’ordre de paiement sur votre application bancaire."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Si votre contact est à coté de vous et qu’il ne souhaite pas donner son numéro de téléphone, il peut générer sur son propre smartphone son QR code d’identification Wero. Avec votre smartphone, vous saisissez le montant à envoyer puis vous scannez le QR code de votre interlocuteur pour lui envoyer le montant correspondant."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Comment recevoir de l’argent avec Wero ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Avez Wero, vous n’avez plus besoin de partager votre "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R11497",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "RIB"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " et votre "
                    },
                    {
                      "type": "element",
                      "name": "LienIntra",
                      "attributes": {
                        "LienID": "R74040",
                        "type": "Définition de glossaire"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "IBAN"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " pour recevoir un paiement."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Quand Wero est activé pour vous et pour la personne qui vous doit de l’argent :"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Liste",
                  "attributes": {
                    "type": "puce"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Donnez simplement votre numéro de téléphone ou votre adresse mail à votre contact, qui saisira sur son smartphone le montant qu’il vous doit. L’ordre de paiement est ensuite validé par votre interlocuteur sur son application bancaire"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Si votre contact est à coté de vous, vous pouvez aussi afficher votre QR code Wero sur votre smartphone, en rentrant dans l’application mobile de votre banque. Présentez le à votre interlocuteur pour qu’il le scanne et vous recevrez immédiatement l’argent qu’il vous doit."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "ASavoir",
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "À savoir"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Wero vous permet aussi de demander de l’argent à un de vos contact. Avec votre smartphone, sur votre application bancaire, vous saisissez le montant demandé et vous sélectionnez le contact à qui vous adressez votre demande."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "name": "Chapitre",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Existe-il un montant minimum et maximum pour les transferts d’argent par Wero ?"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Le plus souvent, le montant minimum est de "
                    },
                    {
                      "type": "element",
                      "name": "Valeur",
                      "children": [
                        {
                          "type": "text",
                          "text": "1 €"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " par opération."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Le montant maximum des transferts d’argent par Wero varie selon les banques. La banque peut fixer un plafond par opération et un plafond cumulé par jour."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Selon les banques, différentes conditions d’utilisation sont possibles :"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Liste",
                  "attributes": {
                    "type": "puce"
                  },
                  "children": [
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Le plafond des opérations Wero peut être indépendant du plafond applicable à vos "
                            },
                            {
                              "type": "element",
                              "name": "LienInterne",
                              "attributes": {
                                "LienPublication": "F2384",
                                "type": "Fiche d'information conditionnée",
                                "audience": "Particuliers"
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "text": "virements SEPA"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Item",
                      "children": [
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Les opérations Wero peuvent être prises en compte dans un plafond global applicable à l’ensemble des virements réalisés depuis votre application bancaire."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Renseignez-vous en lisant les conditions générales d’utilisation de Wero, accessibles sur le site internet de votre banque."
                    }
                  ]
                }
              ]
            }
          ]
        },
