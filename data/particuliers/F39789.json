              "children": [
                {
                  "type": "text",
                  "text": "Délivrance à la naissance du 1er enfant"
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F1345"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Délivrance lors du mariage"
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F18910"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Mise à jour : mariage, naissance, divorce, décès..."
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F11996"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Second livret lors d'une séparation"
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F11994"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Perte, vol ou destruction du livret"
                }
              ]
            }
