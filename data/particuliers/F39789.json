        },
        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "Oui"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", il est possible d’avoir plusieurs livrets de famille lorsque des "
                },
                {
                  "type": "element",
                  "name": "MiseEnEvidence",
                  "children": [
                    {
                      "type": "text",
                      "text": "enfants sont nés de différentes unions"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Lorsqu'un livret de famille est établi au nom de 2 parents, seuls les enfants communs à ces derniers peuvent y être inscrits."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Si l’un des parents a un enfant avec une autre personne, cet enfant sera inscrit sur un autre livret de famille."
                }
              ]
            },
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "Ainsi, il n’est pas possible de faire figurer sur un même livret de famille des demi-frères et demi-sœurs nés d’unions différentes."
                }
              ]
            },
            {
              "type": "element",
              "name": "Exemple",
              "children": [
                {
                  "type": "element",
                  "name": "Titre",
                  "children": [
                    {
                      "type": "text",
                      "text": "Exemple"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Vous donnez naissance à un fils en 2024 et le reconnaissez. Par la suite, vous rencontrez votre conjoint, qui ne souhaite pas reconnaître cet enfant."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "En 2026, vous donnez naissance à une fille. Vous et votre conjoint l'avez reconnue avant sa naissance."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "La naissance de votre fils vous a permis d'obtenir un premier livret de famille. En revanche, votre fille ne peut pas y être inscrite, puisqu'elle n'est pas l'enfant commun des 2 parents mentionnés sur ce livret."
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Un second livret de famille vous est donc délivré. Celui-ci mentionne votre fille ainsi que ses 2 parents, à savoir vous et votre conjoint."
                    }
                  ]
                }
              ]
            }
          ]
