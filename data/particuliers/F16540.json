                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Acronyme de "
                    },
                    {
                      "type": "element",
                      "name": "Expression",
                      "children": [
                        {
                          "type": "text",
                          "text": "Système d'identification du répertoire des établissements"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Le numéro de Siret est un identifiant géographique d'un établissement ou d'une entreprise, composé de 14 chiffres."
                    }
                  ]
                }
              ]
            }
          ]
        },
