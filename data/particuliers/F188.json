              "type": "element",
              "name": "Titre",
              "children": [
                {
                  "type": "text",
                  "text": "Pénalité"
                }
              ]
            },
            {
              "type": "element",
              "name": "Texte",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Sanction en cas de non respect d'obligations. Elle se traduit souvent sous la forme d'intérêts de retard ou de majorations de paiement."
                    }
                  ]
                }
              ]
            }
          ]
        },
