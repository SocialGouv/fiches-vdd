          "children": [
            {
              "type": "element",
              "name": "Texte",
              "children": [
                {
                  "type": "element",
                  "name": "Paragraphe",
                  "children": [
                    {
                      "type": "text",
                      "text": "Les "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "électeurs français"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", lorsqu’ils sont inscrits sur les listes électorales, "
