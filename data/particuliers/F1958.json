                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ". La date précise des élections doit être communiquée aux électeurs au moins 6 semaines avant le 1"
                        },
                        {
                          "type": "element",
                          "name": "Exposant",
                          "children": [
                            {
                              "type": "text",
