                        {
                          "type": "text",
                          "text": " par les électeurs français inscrits sur les listes électorales en France."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Pour chaque canton, un binôme (femme-homme) est élu au "
