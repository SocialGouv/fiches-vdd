                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "élisent"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " les "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "conseillers régionaux"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " et les "
                    },
                    {
                      "type": "element",
                      "name": "MiseEnEvidence",
                      "children": [
                        {
                          "type": "text",
                          "text": "conseillers départementaux"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Le mode de scrutin diffère entre l’élection des conseillers régionaux et celle des conseillers départementaux. Nous vous présentons les informations à connaître."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "element",
          "name": "ListeSituations",
          "attributes": {
