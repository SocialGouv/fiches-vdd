                  "children": [
                    {
                      "type": "text",
                      "text": "\nÉlections régionales"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Texte",
                  "children": [
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Les prochaines élections régionales sont prévues en "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "mars 2028"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ". La date précise des élections doit être communiquée aux électeurs au moins 6 semaines avant le 1"
                        },
                        {
                          "type": "element",
                          "name": "Exposant",
                          "children": [
                            {
                              "type": "text",
                              "text": "er"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " tour."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Les conseillers régionaux sont élus pour une "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "durée de 6 ans"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " par les électeurs français inscrits sur les listes électorales en France."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Ils sont élus au "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "suffrage universel direct par un mode de scrutin proportionnel,"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " aussi appelé scrutin de liste."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Le site Vie-Publique.fr présente le "
                        },
                        {
                          "type": "element",
                          "name": "LienExterne",
                          "attributes": {
                            "URL": "https://www.vie-publique.fr/fiches/20177-quel-est-le-mode-de-scrutin-pour-les-elections-regionales"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "mode de scrutin pour les élections régionales"
