              "children": [
                {
                  "type": "text",
                  "text": "Actes d'état civil"
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F1427"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Acte de naissance"
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F1432"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Acte de mariage"
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F1444"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Acte de décès"
                }
              ]
            }
          ]
        },
        {
          "type": "element",
          "name": "Texte",
          "children": [
            {
              "type": "element",
              "name": "Paragraphe",
              "children": [
                {
                  "type": "text",
                  "text": "La démarche à suivre est différente selon que l'acte d'état civil est destiné à être utilisé dans un pays de "
                },
                {
                  "type": "element",
                  "name": "LienIntra",
                  "attributes": {
                    "LienID": "R41270",
                    "type": "Définition de glossaire"
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "l'Union européenne (UE)"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " ou dans un autre pays :"
                }
              ]
            },
            {
              "type": "element",
              "name": "BlocCas",
              "attributes": {
                "affichage": "radio"
              },
              "children": [
                {
                  "type": "element",
                  "name": "Cas",
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "Utiliser un acte d'état civil français dans un pays de l'UE"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Pour utiliser un acte d'état civil français au sein de l'Union européenne, vous n'avez pas besoin de demander l'"
                        },
                        {
                          "type": "element",
                          "name": "LienIntra",
                          "attributes": {
                            "LienID": "R68313",
                            "type": "Définition de glossaire"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "authentification de l'acte"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ". Vous n'avez pas non plus à obtenir la "
                        },
                        {
                          "type": "element",
                          "name": "LienIntra",
                          "attributes": {
                            "LienID": "R68317",
                            "type": "Définition de glossaire"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "certification"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " du pays européen dans lequel vous résidez."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Toutefois, l'acte d'état civil "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "doit être rédigé dans la langue du pays"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Pour vous aider à obtenir une traduction de votre document, sans coût supplémentaire, et pour éviter la nécessité de recourir à un "
                        },
                        {
                          "type": "element",
                          "name": "LienInterne",
                          "attributes": {
                            "LienPublication": "F12956",
                            "type": "Fiche Question-réponse conditionnée",
                            "audience": "Particuliers"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "traducteur agréé"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ", une démarche simplifiée a été mise en place par la Commission européenne via un "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "formulaire de type"
                            },
                            {
                              "type": "element",
                              "name": "Expression",
                              "children": [
                                {
                                  "type": "text",
                                  "text": " multilingue"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Expression",
                          "children": [
                            {
                              "type": "text",
                              "text": ". "
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "Ce document permet de fournir une traduction standardisée d'un extrait d'acte d'état civil français dans plusieurs langues européennes, afin de faciliter sa compréhension et son utilisation dans d'autres pays membres de l'UE. Il est considéré comme une "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "traduction certifiée de l'acte d'état civil français"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Exemple",
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "Exemple"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Ce formulaire est utilisé lors de démarches administratives telles qu'un mariage ou une reconnaissance de parenté."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Attention",
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "Attention"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Ce formulaire est uniquement destiné aux autorités nationales autorisées, c'est-à-dire que "
                            },
                            {
                              "type": "element",
                              "name": "MiseEnEvidence",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "vous ne pouvez pas le préremplir"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": "."
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Pour un acte de naissance, vous devrez vous adresser auprès de la mairie qui a délivré l'acte."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "De ce fait, lors de votre démarche dans un autre pays de l'Union européenne, ce formulaire, une fois rempli par la mairie, doit être joint à votre acte d'état civil français."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "La mairie doit vous remplir le formulaire gratuitement. Vous pouvez l'obtenir sur place ou en faire la demande en ligne."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "ASavoir",
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "À savoir"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Paragraphe",
                          "children": [
                            {
                              "type": "text",
                              "text": "Vous pouvez consulter le "
                            },
                            {
                              "type": "element",
                              "name": "LienExterne",
                              "attributes": {
                                "URL": "https://e-justice.europa.eu/topics/taking-legal-action/european-judicial-atlas-civil-matters/public-documents_fr?clang=fr"
                              },
                              "children": [
                                {
                                  "type": "text",
                                  "text": "site e-justice"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " pour obtenir des informations complémentaires liées aux langues d'usage de chaque pays de l'UE."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "Cas",
                  "children": [
                    {
                      "type": "element",
                      "name": "Titre",
                      "children": [
                        {
                          "type": "text",
                          "text": "Utiliser un acte d'état civil à l'étranger"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Pour présenter un document français auprès d'une autorité étrangère (hors UE), "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "l'authentification préalable de la signature de l'autorité ayant délivré le document"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " peut être exigée ("
                        },
                        {
                          "type": "element",
                          "name": "LienIntra",
                          "attributes": {
                            "LienID": "R73028",
                            "type": "Définition de glossaire"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "légalisation"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " ou "
                        },
                        {
                          "type": "element",
                          "name": "LienIntra",
                          "attributes": {
                            "LienID": "R47841",
                            "type": "Définition de glossaire"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "apostille"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": ")."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "La légalisation et l'apostille "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "attestent des informations suivantes"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " :"
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Liste",
                      "attributes": {
                        "type": "puce"
                      },
                      "children": [
                        {
                          "type": "element",
                          "name": "Item",
                          "children": [
                            {
                              "type": "element",
                              "name": "Paragraphe",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Véracité de la "
                                },
                                {
                                  "type": "element",
                                  "name": "MiseEnEvidence",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "signature"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "text": " de l'auteur du document"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Item",
                          "children": [
                            {
                              "type": "element",
                              "name": "Paragraphe",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Qualité en laquelle le "
                                },
                                {
                                  "type": "element",
                                  "name": "MiseEnEvidence",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "signataire"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "text": " du document a agi"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "Item",
                          "children": [
                            {
                              "type": "element",
                              "name": "Paragraphe",
                              "children": [
                                {
                                  "type": "text",
                                  "text": "Si nécessaire, l’"
                                },
                                {
                                  "type": "element",
                                  "name": "MiseEnEvidence",
                                  "children": [
                                    {
                                      "type": "text",
                                      "text": "identité du sceau ou du timbre"
                                    }
                                  ]
                                },
                                {
                                  "type": "text",
                                  "text": " qui est mentionné sur le document."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "En pratique, la légalisation et l'apostille sont un "
                        },
                        {
                          "type": "element",
                          "name": "MiseEnEvidence",
                          "children": [
                            {
                              "type": "text",
                              "text": "cachet officiel"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " ajouté sur le document."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Pour vérifier si le document doit être légalisé, apostillé ou est dispensé de formalité, vous devez consulter le "
                        },
                        {
                          "type": "element",
                          "name": "LienExterne",
                          "attributes": {
                            "URL": "https://www.diplomatie.gouv.fr/files/files/pdf/leg-tableau-recap-du-droit-conventionnel-09-07-26-2.pdf",
                            "format": "application/pdf",
                            "poids": "793.1 KB"
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "récapitulatif des règles par pays"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " mis à jour par le ministère des affaires étrangères."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "Paragraphe",
                      "children": [
                        {
                          "type": "text",
                          "text": "Vous pouvez aussi vous renseigner auprès de l'ambassade ou du consulat en France du pays de destination."
                        }
                      ]
                    },
                    {
                      "type": "element",
                      "name": "OuSAdresser",
                      "attributes": {
                        "ID": "R2884",
                        "sve": "non",
                        "type": "Local"
                      },
                      "children": [
                        {
                          "type": "element",
                          "name": "Titre",
                          "children": [
                            {
                              "type": "text",
                              "text": "Ambassade ou consulat étranger en France"
                            }
                          ]
                        },
                        {
                          "type": "element",
                          "name": "RessourceWeb",
                          "attributes": {
                            "URL": "https://www.diplomatie.gouv.fr/fr/services/j-ai-une-question/annuaire-et-contacts/representations-etrangeres"
                          }
