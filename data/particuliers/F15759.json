              "children": [
                {
                  "type": "text",
                  "text": "Contrats d'insertion"
                }
              ]
            },
            {
              "type": "element",
              "name": "Fiche",
              "attributes": {
                "ID": "F21006"
              },
              "children": [
                {
                  "type": "text",
                  "text": "Contrat unique d'insertion (CUI) - Parcours emploi compétences (PEC)"
                }
              ]
            },
            {
              "type": "element",
